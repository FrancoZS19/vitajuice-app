datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum Role {
  ADMIN
  OPERADOR
  VENDEDOR
}

enum OrderStatus {
  PENDIENTE
  EN_PREPARACION
  EN_CAMINO
  ENTREGADO
  CANCELADO
}

enum PaymentStatus {
  PENDIENTE
  PAGADO
  RECHAZADO
}

// -------------------------------------------------------------
// 1. USUARIOS Y AUTENTICACIÓN
// -------------------------------------------------------------

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(ADMIN)
  active    Boolean  @default(true)
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// -------------------------------------------------------------
// 2. CLIENTES (Canal WhatsApp y Redes)
// -------------------------------------------------------------

model Customer {
  id        String   @id @default(uuid())
  name      String
  phone     String   @unique
  email     String?
  address   String?
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("customers")
}

// -------------------------------------------------------------
// 3. CATÁLOGO DE PRODUCTOS (7 Shots + Jugos VitaJuice)
// -------------------------------------------------------------

model Product {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  category    String       @default("SHOT") // SHOT, JUICE, PACK
  price       Decimal      @db.Decimal(10, 2)
  minStock    Int          @default(10)
  active      Boolean      @default(true)
  imageUrl    String?
  recipes     RecipeItem[]
  orderItems  OrderItem[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("products")
}

// -------------------------------------------------------------
// 4. INVENTARIO DE INSUMOS / MATERIA PRIMA
// -------------------------------------------------------------

model Supply {
  id            String           @id @default(uuid())
  name          String           @unique
  unit          String           // "g", "kg", "ml", "unidad"
  currentStock  Decimal          @db.Decimal(10, 2) @default(0.00)
  minStockAlert Decimal          @db.Decimal(10, 2) @default(100.00)
  lastCost      Decimal          @db.Decimal(10, 2) @default(0.00) // Costo unitario referencial
  recipes       RecipeItem[]
  purchases     SupplyPurchase[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@map("supplies")
}

// -------------------------------------------------------------
// 5. COMPRAS Y LOTES DE INSUMOS (Trazabilidad y Vencimiento)
// -------------------------------------------------------------

model SupplyPurchase {
  id             String    @id @default(uuid())
  supplyId       String
  supply         Supply    @relation(fields: [supplyId], references: [id], onDelete: Cascade)
  quantity       Decimal   @db.Decimal(10, 2)
  unitCost       Decimal   @db.Decimal(10, 2)
  totalCost      Decimal   @db.Decimal(10, 2)
  purchaseDate   DateTime  @default(now())
  expirationDate DateTime? // Fundamental para materias primas perecederas
  supplier       String?   // Proveedor (ej. Mercado Mayorista Frutas)
  batchNumber    String?   // Número de lote
  createdAt      DateTime  @default(now())

  @@map("supply_purchases")
}

// -------------------------------------------------------------
// 6. RECETA / FICHA TÉCNICA (Relación Producto ↔ Insumo)
// -------------------------------------------------------------

model RecipeItem {
  id             String   @id @default(uuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplyId       String
  supply         Supply   @relation(fields: [supplyId], references: [id], onDelete: Restrict)
  quantityNeeded Decimal  @db.Decimal(10, 3) // Cantidad requerida para 1 unidad de producto

  @@unique([productId, supplyId])
  @@map("recipe_items")
}

// -------------------------------------------------------------
// 7. PEDIDOS Y VENTAS
// -------------------------------------------------------------

model Order {
  id            String        @id @default(uuid())
  orderNumber   String        @unique // Ej. VJ-2026-001
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  userId        String?
  user          User?         @relation(fields: [userId], references: [id])
  status        OrderStatus   @default(PENDIENTE)
  paymentStatus PaymentStatus @default(PENDIENTE)
  totalAmount   Decimal       @db.Decimal(10, 2)
  paymentMethod String?       // "CULQI", "YAPE", "EFECTIVO", "TRANSFERENCIA"
  deliveryDate  DateTime?
  notes         String?
  items         OrderItem[]
  payments      Payment[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("orders")
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal  @db.Decimal(10, 2)
  subtotal  Decimal  @db.Decimal(10, 2)

  @@map("order_items")
}

// -------------------------------------------------------------
// 8. PAGOS (Pasarela Culqi y Auditoría)
// -------------------------------------------------------------

model Payment {
  id            String   @id @default(uuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider      String   @default("CULQI")
  transactionId String   @unique // Ej. chr_test_66f2c6...
  amount        Decimal  @db.Decimal(10, 2)
  currency      String   @default("PEN")
  status        String   // "SUCCESS", "FAILED"
  payload       Json?    // Respuesta completa de Culqi para auditoría
  createdAt     DateTime @default(now())

  @@map("payments")
}
